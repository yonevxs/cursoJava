package program;

import java.time.Instant;
import java.time.LocalDate;
import java.time.LocalDateTime;
import java.time.ZoneId;
import java.time.format.DateTimeFormatter;

public class Main {

	public static void main(String[] args) {
		LocalDate d04 = LocalDate.parse("2022-07-20");
		LocalDateTime d05 = LocalDateTime.parse("2022-07-20T01:30:26");
		Instant d06 = Instant.parse("2022-07-20T01:30:26Z");
		
		DateTimeFormatter fmt1 = DateTimeFormatter.ofPattern("dd/MM/yyyy");	
		
		// Pegando o DateTimeFormatter e definindo como quero transformar meu objeto D04 para String 
		// 3 Maneiras diferentes
		System.out.println("D04 = " + d04.format(fmt1));		
		System.out.println("D04 = " + fmt1.format(d04));
		System.out.println("D04 = " + d04.format(DateTimeFormatter.ofPattern("dd/MM/yyyy")));
		
		// Formatando LocalDateTime
		System.out.println();
		DateTimeFormatter fmt2 = DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm");
		System.out.println("D05 = " + d05.format(fmt1));
		System.out.println("D05 = " + d05.format(fmt2));
		
		// Formatando Instant - para isso temos que definir o fuso horário que vamos considerar
		// Imprimimos a data-hora no fuso do usuário, logo, vai ser 22h30 do dia anterior!
		System.out.println();
		DateTimeFormatter fmt3 = DateTimeFormatter.ofPattern("dd/MM/yyyy HH:mm").withZone(ZoneId.systemDefault()); // O último método pega o fuso horário do PC do usuário
		System.out.println("D06 = " + fmt3.format(d06));
		
	}

}
