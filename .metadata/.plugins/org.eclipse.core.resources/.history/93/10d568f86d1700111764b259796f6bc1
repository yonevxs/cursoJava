package program;

import java.text.SimpleDateFormat;
import java.time.Instant;
import java.util.Calendar;
import java.util.Date;

public class Main {

	public static void main(String[] args) {
		SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy HH:mm:ss");
		Date d = Date.from(Instant.parse("2018-06-25T15:42:07Z"));
		
		System.out.println(sdf.format(d));
		
		// Acrescentar 4 horas nessa data - Usando Calendar
		Calendar cal = Calendar.getInstance();
		cal.setTime(d); // Calendario com a minha data instanciada dentro do parametro, agora podemos acrescentar ou diminuir tempo
		cal.add(Calendar.HOUR_OF_DAY, 4); // A data que ta no calendario terá 4 horas acrescidas
		
		// Atualizando a variavel D com a data atualizada
		d = cal.getTime();
		System.out.println(sdf.format(d));

		
		// Obtendo uma unidade de tempo
		int minutes = cal.get(Calendar.MINUTE);
		System.out.println("Minutos: " + minutes);
		
		int month = cal.get(Calendar.MONTH);
		System.out.println("Meses: " + month);
	}

}
